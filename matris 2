// Online C++ compiler to run C++ program online
#include <iostream>
using namespace std;
int main() {
int n;
int A[n][n];
int a;
int i,j;

cin>>n;
for(i=0;i<n;i++)
{
    for(j=0;j<n;j++)
    {
    cin>>A[i][j];
    }
}
a=0;
for(i=0;i<n;i++)
{
    for(j=0;j<n;j++)
    {
    a=a+A[i][j];
    cout<<a;
    }
    cout<<endl;

    return 0;
}
}
